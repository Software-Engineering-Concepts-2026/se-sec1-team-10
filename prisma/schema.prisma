generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                 String         @id @default(uuid())
  email              String         @unique
  passwordHash       String
  displayName        String
  age                Int?
  weightKg           Float?
  heightCm           Float?
  targetWeightKg     Float?
  dailyCalorieTarget Int?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
  sessions           Session[]
  exerciseLogs       ExerciseLog[]
  mealLogs           MealLog[]
  weightLogs         WeightLog[]
  aiDailyQuotas      AiDailyQuota[]
}

model AiDailyQuota {
  userId    String
  day       DateTime @db.Date
  scanCount Int      @default(0)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, day])
}

model WeightLog {
  id       String   @id @default(uuid())
  userId   String
  weightKg Float
  heightCm Float
  loggedAt DateTime @default(now())
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, loggedAt])
}

model MealLog {
  id            String           @id @default(uuid())
  userId        String
  name          String
  mealType      String
  imageData     String?
  totalCalories Int
  activityDate  DateTime         @db.Date
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  user          User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  ingredients   MealIngredient[]

  @@index([userId, activityDate])
}

model MealIngredient {
  id                    String  @id @default(uuid())
  mealLogId             String
  name                  String
  carbsGrams            Float
  sugarGrams            Float
  proteinGrams          Float
  fatGrams              Float
  amount                Float   @default(1)
  unit                  String  @default("serving")
  referenceAmount       Float   @default(1)
  referenceUnit         String  @default("serving")
  source                String  @default("legacy")
  referenceCaloriesKcal Float?
  referenceCarbsGrams   Float?
  referenceSugarGrams   Float?
  referenceProteinGrams Float?
  referenceFatGrams     Float?
  mealLog               MealLog @relation(fields: [mealLogId], references: [id], onDelete: Cascade)

  @@index([mealLogId])
}

model Session {
  id        String   @id @default(uuid())
  userId    String
  expiresAt DateTime
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model ExerciseLog {
  id              String   @id @default(uuid())
  userId          String
  activityType    String
  durationMinutes Int
  weightKg        Float
  caloriesBurned  Int
  activityDate    DateTime @db.Date
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, activityDate])
}

model Food {
  id            String  @id @default(uuid())
  name          String
  aliases       String[] @default([])
  caloriesKcal  Float
  carbsGrams    Float?
  sugarGrams    Float?
  proteinGrams  Float?
  fatGrams      Float?
  servingAmount Float   @default(1)
  servingUnit   String  @default("serving")
  imageUrl      String?
  servingWeightGrams Float?
  sourceName    String?
  sourceUrl     String?
  catalogKey    String? @unique

  createdByUserId String?
  isCustom        Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([name])
  @@index([aliases], type: Gin)
}
