DATABASE_URL=postgresql://lifebalance:local-development-only@localhost:5432/lifebalance?schema=public
# Replace with a randomly generated secret of at least 32 characters.
JWT_SECRET=replace-this-with-a-random-secret-before-running
APP_ORIGIN=http://localhost:5173
PORT=3000
NODE_ENV=development
# Optional image-analysis provider. Accepts a /v1 base URL or complete /chat/completions endpoint.
# Example: https://ai.example.edu/v1
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
# Provider abort budget in milliseconds, whole number 1000..60000. Restart API after changes.
AI_TIMEOUT_MS=45000
# Per-account calendar-day limit, from 1 to 50. Leave at the conservative default.
AI_DAILY_SCAN_LIMIT=50
# Optional USDA FoodData Central API key for verified food-search results.
NUTRITION_API_KEY=
